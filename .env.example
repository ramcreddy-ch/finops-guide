# Copy this to .env and adjust as needed. None of these are required to run
# the simulator/demo mode - they only matter if you wire up a real provider
# adapter (see docs/10-multi-cloud-normalization.md).

FINOPS_DB_PATH=data/finops.db
FINOPS_BUDGETS_FILE=config/budgets.yaml

# simulated clock: how many real seconds = 1 simulated hour when running
# `finops serve` or `finops simulate` live
FINOPS_TICK_SECONDS=5

# real provider credentials (optional, only for the "real" adapters)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
